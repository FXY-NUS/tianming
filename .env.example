# 复制为 .env.local（已在 .gitignore 里），永远不要 commit 真实值。

# ── 服务端（代理）变量：只在 Node / Cloudflare Worker 侧读取，不会进前端 bundle ──
# Gemini API Key。本地 `npm run dev` / `npm run preview` 的内置 /api/* 代理从这里读。
GEMINI_API_KEY=
# 允许跨域访问代理的来源，逗号分隔；同源请求无需配置。浏览器扩展填 chrome-extension://<扩展 id>。
ALLOWED_ORIGINS=
# 可选共享口令。设置后请求必须带 Authorization: Bearer <PROXY_TOKEN>。
PROXY_TOKEN=

# ── 前端变量（VITE_ 前缀会被打进 bundle，别放任何密钥）──
# 缺省走代理；填 byok 才在浏览器里用用户自带 Key 直连 Gemini（开发 / BYOK 模式）。
VITE_LLM_MODE=
# 代理部署在别的域名时填写，例如 https://tianming-proxy.<account>.workers.dev；缺省同源。
VITE_TIANMING_API_BASE=
# 代理开启 PROXY_TOKEN 时前端携带的口令（会进 bundle，只适合私人部署）。
VITE_TIANMING_PROXY_TOKEN=
