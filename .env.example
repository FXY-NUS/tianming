# 复制为 .env.local（已在 .gitignore 里），永远不要 commit 真实值。

# ── 服务端（代理）变量：只在 Node / Cloudflare Worker 侧读取，不会进前端 bundle ──
# 用哪家模型：gemini（缺省）| deepseek | kimi。只需填所选那家的 Key。
# 本地 `npm run dev` / `npm run preview` 的内置 /api/* 代理从这里读。
LLM_PROVIDER=
GEMINI_API_KEY=
# DeepSeek：platform.deepseek.com 申请。
DEEPSEEK_API_KEY=
# Kimi（Moonshot）：缺省走国内站 api.moonshot.cn；Key 是在国际站 platform.moonshot.ai 申请的，
# 把 LLM_BASE_URL 设成 https://api.moonshot.ai/v1。
KIMI_API_KEY=
# 可选：覆盖模型名。快档用于初筛 / 对话 / JD 证据抽取，强档用于深审 / 简历解析。
# 缺省：deepseek-chat / deepseek-chat；kimi-k2-0905-preview / kimi-k2-0905-preview。
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# 可选：覆盖兼容 OpenAI 服务商的接口地址。
LLM_BASE_URL=
# 允许跨域访问代理的来源，逗号分隔；同源请求无需配置。浏览器扩展填 chrome-extension://<扩展 id>。
ALLOWED_ORIGINS=
# 可选共享口令。设置后请求必须带 Authorization: Bearer <PROXY_TOKEN>。
PROXY_TOKEN=

# ── 前端变量（VITE_ 前缀会被打进 bundle，别放任何密钥）──
# 缺省走代理；填 byok 才在浏览器里用用户自带 Key 直连 Gemini（开发 / BYOK 模式）。
VITE_LLM_MODE=
# 代理部署在别的域名时填写，例如 https://tianming-proxy.<account>.workers.dev；缺省同源。
VITE_TIANMING_API_BASE=
# 代理开启 PROXY_TOKEN 时前端携带的口令（会进 bundle，只适合私人部署）。
VITE_TIANMING_PROXY_TOKEN=
